{
  "schema_version": 1,
  "description": "Agent-facing registry for Terra telemetry keys emitted by the main SDK modules. Keep this in sync with Sources/Terra/Terra+Constants.swift and module-specific key owners.",
  "entry_required_fields": [
    "key",
    "type",
    "unit",
    "owner_module",
    "stability",
    "viewer_behavior",
    "examples"
  ],
  "allowed_types": [
    "string",
    "int",
    "double",
    "bool",
    "event"
  ],
  "allowed_stability": [
    "stable",
    "experimental",
    "deprecated",
    "internal"
  ],
  "registry": [
    {
      "key": "gen_ai.operation.name",
      "type": "string",
      "unit": "none",
      "owner_module": "Terra",
      "stability": "stable",
      "viewer_behavior": "span_summary",
      "examples": ["inference"],
      "description": "OpenTelemetry GenAI operation name for inference, embeddings, agent, tool, and safety spans."
    },
    {
      "key": "gen_ai.prompt.message_count",
      "type": "int",
      "unit": "count",
      "owner_module": "Terra",
